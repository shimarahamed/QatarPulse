# Copy to .env.local and fill in for local development.
# These NEXT_PUBLIC_FIREBASE_* values are optional — src/firebase/config.ts already has
# working fallback values for the studio-7320841525-43d78 project. Override them here if
# you're pointing this app at a different Firebase project.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=

# Required for AI ingestion flows (Genkit + Gemini).
GEMINI_API_KEY=

# Canonical site URL, used for the sitemap and Open Graph metadata.
NEXT_PUBLIC_SITE_URL=https://qatarpulse.app
